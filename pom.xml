<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.quickbase</groupId>
  <artifactId>tenant-job-scheduler</artifactId>
  <version>1.0.0</version>
  <name>tenant-job-scheduler</name>
  <description>Tenant-aware job scheduler with global, per-tenant and per-target concurrency caps</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- Web MVC. SSE is served with Spring MVC's SseEmitter, which is part of
         this starter - no reactive stack and no third-party SSE library needed. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Jakarta Bean Validation, so malformed enqueue requests are rejected at
         the edge instead of reaching the scheduler with null tenant/target ids. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Generates IDE/metadata support for @ConfigurationProperties binding.
         Build-time only; contributes nothing to the runtime classpath. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- JUnit 5, AssertJ, Mockito, MockMvc. Deliberately NO Awaitility or other
         async-test helpers: the concurrency tests are latch-gated and assert on
         an atomic high-water mark, never on wall-clock timing, so they do not
         need a polling library and cannot go flaky on a slow CI box. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
